// https://mozilla.org/MPL/2.0/
// Investigación educativa — no es asesoría financiera.

//@version=6
indicator("Niveles de sesión · ES / NQ / MNQ", shorttitle="Niveles", overlay=true,
     max_lines_count=100, max_labels_count=100, max_boxes_count=20)

// ─────────────────────────────────────────────────────────────────────────────
// QUÉ DIBUJA
//   · Sesión RTH previa (9:30-16:00 NY): máximo, mínimo y cierre
//   · Globex / rueda nocturna (18:00-9:30): máximo y mínimo
//   · Rango de apertura (initial balance) de los primeros N minutos
//   · VWAP anclado a la apertura del RTH
//   · Pivotes de piso sobre la sesión previa
//   · Rango esperado: apertura ± ATR de sesión
//   · Niveles de opciones (entrada MANUAL, ver abajo)
//
// POR QUÉ LAS OPCIONES SE CARGAN A MANO
//   Pine Script no puede leer una cadena de opciones: `request.security` sólo
//   trae otros símbolos de TradingView, no interés abierto por strike. El muro
//   de calls, el de puts, el max pain y el gamma cero hay que escribirlos.
//   La buena noticia: el interés abierto se actualiza UNA VEZ POR DÍA, así que
//   son cuatro números por la mañana y listo.
//   El tablero web del repo los calcula y los deja listos para copiar:
//     python main.py  →  http://localhost:8000/futuros
//
// EN QUÉ SÍ ES TIEMPO REAL
//   Todo lo demás. El VWAP, el rango de apertura y las distancias se actualizan
//   tick a tick; los extremos de Globex y del RTH previo se fijan solos al
//   cambiar la sesión, sin repintado: cada nivel queda definido cuando su
//   sesión termina y no se vuelve a tocar.
// ─────────────────────────────────────────────────────────────────────────────

// ───────────────────────────── Entradas ─────────────────────────────
grpS = "Sesión"
tzNY        = input.string("America/New_York", "Zona horaria", group=grpS)
sesRTH      = input.session("0930-1600", "Sesión RTH", group=grpS)
sesGlobex   = input.session("1800-0930", "Rueda nocturna (Globex)", group=grpS)
minApertura = input.int(30, "Rango de apertura (minutos)", minval=5, maxval=120, group=grpS)
periodoATR  = input.int(14, "Sesiones para el ATR", minval=2, maxval=50, group=grpS)

grpV = "Qué mostrar"
verRTH    = input.bool(true,  "RTH previo (máx/mín/cierre)", group=grpV)
verGlobex = input.bool(true,  "Globex (máx/mín)",            group=grpV)
verIB     = input.bool(true,  "Rango de apertura",           group=grpV)
verVWAP   = input.bool(true,  "VWAP de sesión",              group=grpV)
verPiv    = input.bool(true,  "Pivotes de piso",             group=grpV)
verPiv23  = input.bool(false, "Pivotes R2/R3/S2/S3",         group=grpV)
verATR    = input.bool(true,  "Rango esperado por ATR",      group=grpV)
verTabla  = input.bool(true,  "Tabla de distancias",         group=grpV)

grpO = "Opciones (carga manual · 0 = ocultar)"
muroCall  = input.float(0.0, "Muro de calls",  group=grpO)
muroPut   = input.float(0.0, "Muro de puts",   group=grpO)
maxPain   = input.float(0.0, "Max pain",       group=grpO)
gammaCero = input.float(0.0, "Gamma cero",     group=grpO)

grpC = "Colores"
// Dos familias: lo que sale del PRECIO y lo que sale de las OPCIONES.
// Arriba o abajo del precio ya lo dice la posición en el gráfico; el color
// se reserva para el ORIGEN del nivel, que es lo que no se puede deducir mirando.
colSesion   = input.color(#4a86de, "Precio y sesión", group=grpC)
colOpciones = input.color(#b8862b, "Opciones",        group=grpC)
colVWAP     = input.color(#8a98b5, "VWAP",            group=grpC)
anchoLinea  = input.int(1, "Grosor de línea", minval=1, maxval=4, group=grpC)
barrasExt   = input.int(60, "Extender N barras a la derecha", minval=10, maxval=500, group=grpC)

grpE = "Estadística de toques"
verStats    = input.bool(true,  "Contar toques y tasa de aguante", group=grpE)
tolATR      = input.float(0.10, "Tolerancia del toque (× ATR)", minval=0.01, maxval=1.0, step=0.01, group=grpE)
margenATR   = input.float(0.25, "Margen de resolución (× ATR)", minval=0.05, maxval=2.0, step=0.05, group=grpE)
maxBarrasRes= input.int(24, "Barras máximas para resolver", minval=3, maxval=200, group=grpE)
nControl    = input.int(2, "Niveles de CONTROL al azar", minval=0, maxval=5, group=grpE,
     tooltip="Líneas puestas al azar dentro del rango, medidas con las mismas reglas. " +
             "Sirven de base de comparación: si tus niveles no le ganan a esto, la tasa " +
             "alta es del método de medición y no del nivel.")

grpA = "Alertas"
avisarCruce = input.bool(true, "Avisar cuando el precio cruza un nivel", group=grpA)
margenAviso = input.float(0.0, "Margen del aviso (puntos)", minval=0.0, group=grpA)

// ───────────────────────── Detección de sesión ─────────────────────────
enRTH    = not na(time(timeframe.period, sesRTH,    tzNY))
enGlobex = not na(time(timeframe.period, sesGlobex, tzNY))
abreRTH    = enRTH    and not enRTH[1]
abreGlobex = enGlobex and not enGlobex[1]

// Estado del RTH en curso y de la sesión previa ya cerrada
var float rthH  = na
var float rthL  = na
var float rthC  = na
var float rthO  = na
var float prevH = na
var float prevL = na
var float prevC = na
var int   tsRTH = na

// Historia de sesiones para el ATR (máximo, mínimo, cierre)
var array<float> hH = array.new<float>()
var array<float> hL = array.new<float>()
var array<float> hC = array.new<float>()

if abreRTH
    // Al abrir una sesión nueva, la que terminaba pasa a ser "la previa"
    if not na(rthH)
        prevH := rthH
        prevL := rthL
        prevC := rthC
        array.push(hH, rthH)
        array.push(hL, rthL)
        array.push(hC, rthC)
        if array.size(hH) > periodoATR + 2
            array.shift(hH)
            array.shift(hL)
            array.shift(hC)
    rthO := open
    rthH := high
    rthL := low
    rthC := close
    tsRTH := time
else if enRTH
    rthH := math.max(rthH, high)
    rthL := math.min(rthL, low)
    rthC := close

// Extremos de la rueda nocturna del día de negociación en curso
var float glxH = na
var float glxL = na
if abreGlobex
    glxH := high
    glxL := low
else if enGlobex
    glxH := math.max(glxH, high)
    glxL := math.min(glxL, low)

// Rango de apertura (initial balance)
var float ibH = na
var float ibL = na
enVentanaIB = enRTH and not na(tsRTH) and (time - tsRTH) < minApertura * 60 * 1000
if abreRTH
    ibH := high
    ibL := low
else if enVentanaIB
    ibH := math.max(ibH, high)
    ibL := math.min(ibL, low)

// VWAP anclado a la apertura del RTH (no al día de TradingView, que incluye ETH)
var float acPV = 0.0
var float acV  = 0.0
if abreRTH
    acPV := 0.0
    acV := 0.0
if enRTH
    vol = na(volume) ? 0.0 : volume
    acPV += hlc3 * vol
    acV  += vol
vwapSesion = acV > 0 ? acPV / acV : na

// ATR de sesión: true range contra el cierre de la sesión anterior
atrSesion() =>
    float suma = 0.0
    int   n = 0
    if array.size(hH) >= periodoATR + 1
        for i = 1 to periodoATR
            idx = array.size(hH) - i
            h = array.get(hH, idx)
            l = array.get(hL, idx)
            pc = array.get(hC, idx - 1)
            suma += math.max(h - l, math.max(math.abs(h - pc), math.abs(l - pc)))
            n += 1
    n > 0 ? suma / n : na
atrS = atrSesion()

// Pivotes de piso sobre la sesión previa
pp = na(prevH) ? na : (prevH + prevL + prevC) / 3.0
rg = na(prevH) ? na : prevH - prevL
r1 = na(pp) ? na : 2 * pp - prevL
s1 = na(pp) ? na : 2 * pp - prevH
r2 = na(pp) ? na : pp + rg
s2 = na(pp) ? na : pp - rg
r3 = na(pp) ? na : prevH + 2 * (pp - prevL)
s3 = na(pp) ? na : prevL - 2 * (prevH - pp)

// ──────────────── Estadística de toques: ¿aguanta o se rompe? ────────────────
// Un nivel dibujado no dice nada solo. Lo que importa es: de las veces que el
// precio llegó hasta acá, ¿cuántas rebotó?
//
// ATENCIÓN AL CONTROL. El procedimiento tiene un sesgo propio: una vela que toca
// una resistencia desde abajo suele cerrar por debajo del nivel, así que arranca
// más cerca de la condición de "aguantó" que de la de "rompió". Medido sobre ES
// y NQ, niveles puestos AL AZAR dentro del rango dan ~73% de aguante — más que
// los niveles reales. Por eso el indicador sigue también líneas de control al
// azar y las muestra en la tabla: la tasa absoluta engaña, el exceso sobre el
// control es lo único que informa.
type Seguidor
    string nombre
    float  precio
    int    toques
    int    aguanto
    int    rompio
    int    ambiguos
    bool   abierto
    int    dir
    int    barraToque
    bool   control

var array<Seguidor> seguidores = array.new<Seguidor>()

// Generador pseudoaleatorio determinista (congruencial lineal): Pine no trae
// random(), y los niveles de control tienen que ser reproducibles entre recargas.
// Se actualiza EN LÍNEA dentro del bucle, no en una función: Pine no garantiza que
// una función pueda modificar una variable global.
// Sin desborde: semilla < 2^31 por 1.1e9 da ~2.4e18, bajo el máximo de int64.
var int semilla = 987654321

nuevoSeguidor(string nombre, bool esControl) =>
    Seguidor.new(nombre, na, 0, 0, 0, 0, false, 0, 0, esControl)

if barstate.isfirst and verStats
    array.push(seguidores, nuevoSeguidor("Máx RTH previo", false))
    array.push(seguidores, nuevoSeguidor("Mín RTH previo", false))
    array.push(seguidores, nuevoSeguidor("Cierre RTH prev", false))
    array.push(seguidores, nuevoSeguidor("Máx Globex", false))
    array.push(seguidores, nuevoSeguidor("Mín Globex", false))
    array.push(seguidores, nuevoSeguidor("Pivote PP", false))
    array.push(seguidores, nuevoSeguidor("R1", false))
    array.push(seguidores, nuevoSeguidor("S1", false))
    for i = 0 to 4
        if i < nControl
            array.push(seguidores, nuevoSeguidor("CONTROL azar " + str.tostring(i + 1), true))

// Al abrir la sesión se refrescan los precios seguidos y se cancela lo pendiente.
if verStats and abreRTH and array.size(seguidores) > 0
    float lo = na(prevL) or na(atrS) ? na : prevL - atrS
    float hi = na(prevH) or na(atrS) ? na : prevH + atrS
    for i = 0 to array.size(seguidores) - 1
        Seguidor sg = array.get(seguidores, i)
        sg.abierto := false
        semilla := (semilla * 1103515245 + 12345) % 2147483648
        float azarPrecio = na(lo) or na(hi) ? na : lo + (semilla / 2147483648.0) * (hi - lo)
        sg.precio := switch sg.nombre
            "Máx RTH previo"  => prevH
            "Mín RTH previo"  => prevL
            "Cierre RTH prev" => prevC
            "Máx Globex"      => glxH
            "Mín Globex"      => glxL
            "Pivote PP"       => pp
            "R1"              => r1
            "S1"              => s1
            // Control: un precio al azar dentro del rango previo ampliado por un ATR
            => azarPrecio

// Máquina de estados, idéntica a la del módulo de Python que se testeó aparte.
if verStats and enRTH and not na(atrS) and array.size(seguidores) > 0
    float tol = tolATR * atrS
    float mrg = margenATR * atrS
    for i = 0 to array.size(seguidores) - 1
        Seguidor sg = array.get(seguidores, i)
        if not na(sg.precio)
            if not sg.abierto
                if low <= sg.precio + tol and high >= sg.precio - tol
                    sg.abierto := true
                    sg.toques += 1
                    sg.barraToque := bar_index
                    // Desde abajo = el nivel actúa de resistencia
                    sg.dir := close[1] < sg.precio ? 1 : -1
            else if bar_index > sg.barraToque
                bool arriba = high >= sg.precio + mrg
                bool abajo  = low  <= sg.precio - mrg
                if arriba and abajo
                    // Una sola vela hizo las dos cosas: con velas no se sabe cuál
                    // ocurrió primero, así que no se decide.
                    sg.ambiguos += 1
                    sg.abierto := false
                else if sg.dir == 1
                    if arriba
                        sg.rompio += 1
                        sg.abierto := false
                    else if abajo
                        sg.aguanto += 1
                        sg.abierto := false
                else
                    if abajo
                        sg.rompio += 1
                        sg.abierto := false
                    else if arriba
                        sg.aguanto += 1
                        sg.abierto := false
                if sg.abierto and bar_index - sg.barraToque >= maxBarrasRes
                    sg.abierto := false      // sin resolver: no suma a ningún lado

// Base del control: promedio de las líneas al azar, para comparar contra ella.
baseControl() =>
    int ag = 0
    int re = 0
    if array.size(seguidores) > 0
        for i = 0 to array.size(seguidores) - 1
            Seguidor sg = array.get(seguidores, i)
            if sg.control
                ag += sg.aguanto
                re += sg.aguanto + sg.rompio
    re > 0 ? 100.0 * ag / re : na

// ───────────────── Dibujo: una línea + etiqueta por nivel ─────────────────
// Se crean una sola vez y se reposicionan; así no se acumulan objetos ni se
// toca el límite de 100 líneas del indicador.
// `var` dentro de una función crea UNA instancia por sitio de llamada, que es
// justo lo que hace falta: cada nivel tiene su línea y su etiqueta, se crean una
// sola vez y después sólo se reposicionan. Ocultar = color transparente, porque
// line.set_xy no acepta `na` en la coordenada x.
dibujar(float precio, string texto, color col, bool mostrar, bool punteada) =>
    var line  ln = line.new(bar_index, close, bar_index, close,
         xloc=xloc.bar_index, color=color.new(color.gray, 100))
    var label lb = label.new(bar_index, close, "", xloc=xloc.bar_index,
         style=label.style_label_left, textalign=text.align_left, size=size.small,
         color=color.new(color.gray, 100), textcolor=color.new(color.gray, 100))
    if barstate.islast
        visible = mostrar and not na(precio)
        y = visible ? precio : close
        line.set_xy1(ln, bar_index - 1, y)
        line.set_xy2(ln, bar_index + barrasExt, y)
        line.set_color(ln, visible ? col : color.new(col, 100))
        line.set_width(ln, anchoLinea)
        line.set_style(ln, punteada ? line.style_dashed : line.style_solid)
        label.set_xy(lb, bar_index + barrasExt, y)
        // Distancia = nivel − precio: positiva si el nivel está arriba.
        dist = visible ? precio - close : 0.0
        label.set_text(lb, visible ? texto + "  " + str.tostring(precio, format.mintick)
             + "  (" + (dist > 0 ? "+" : "") + str.tostring(dist, "#.##") + ")" : "")
        label.set_textcolor(lb, visible ? col : color.new(col, 100))
        label.set_color(lb, color.new(color.black, 100))
    true

dibujar(prevH,  "Máx RTH previo",  colSesion,   verRTH,    false)
dibujar(prevL,  "Mín RTH previo",  colSesion,   verRTH,    false)
dibujar(prevC,  "Cierre RTH prev", colSesion,   verRTH,    true)
dibujar(glxH,   "Máx Globex",      colSesion,   verGlobex, false)
dibujar(glxL,   "Mín Globex",      colSesion,   verGlobex, false)
dibujar(ibH,    "Alto apertura",   colSesion,   verIB,     true)
dibujar(ibL,    "Bajo apertura",   colSesion,   verIB,     true)
dibujar(pp,     "Pivote PP",       colSesion,   verPiv,    true)
dibujar(r1,     "R1",              colSesion,   verPiv,    true)
dibujar(s1,     "S1",              colSesion,   verPiv,    true)
dibujar(r2,     "R2",              colSesion,   verPiv and verPiv23, true)
dibujar(s2,     "S2",              colSesion,   verPiv and verPiv23, true)
dibujar(r3,     "R3",              colSesion,   verPiv and verPiv23, true)
dibujar(s3,     "S3",              colSesion,   verPiv and verPiv23, true)
dibujar(na(rthO) or na(atrS) ? na : rthO + atrS, "Techo ATR", colSesion, verATR, true)
dibujar(na(rthO) or na(atrS) ? na : rthO - atrS, "Piso ATR",  colSesion, verATR, true)
dibujar(muroCall  > 0 ? muroCall  : na, "Muro calls", colOpciones, true, false)
dibujar(muroPut   > 0 ? muroPut   : na, "Muro puts",  colOpciones, true, false)
dibujar(maxPain   > 0 ? maxPain   : na, "Max pain",   colOpciones, true, true)
dibujar(gammaCero > 0 ? gammaCero : na, "Gamma cero", colOpciones, true, true)

plot(verVWAP and enRTH ? vwapSesion : na, "VWAP de sesión", color=colVWAP, linewidth=2)

// ───────────────────────────── Tabla ─────────────────────────────
// La tabla y las funciones que la llenan van en ámbito global: Pine no admite
// declarar funciones dentro de un `if`.
var table t = table.new(position.top_right, 5, 14, border_width=1,
     frame_color=color.new(#1e2a45, 0), frame_width=1)

celda(int c, int r, string txt, color col, color fondo) =>
    table.cell(t, c, r, txt, text_color=col, text_size=size.small,
         text_halign=c == 0 ? text.align_left : text.align_right, bgcolor=fondo)
    true

// Fila con precio, distancia y —si hay estadística— tasa de aguante y cantidad.
fila(int r, string k, float v, color col, int aguanto, int rompio) =>
    if verTabla and barstate.islast and not na(v)
        fondo = color.new(#111a2b, 10)
        celda(0, r, k, col, fondo)
        celda(1, r, str.tostring(v, format.mintick), #e8edf7, fondo)
        d = v - close
        celda(2, r, (d > 0 ? "+" : "") + str.tostring(d, "#.##"), #8a98b5, fondo)
        int n = aguanto + rompio
        celda(3, r, n > 0 ? str.tostring(math.round(100.0 * aguanto / n)) + "%" : "—",
             n >= 8 ? #e8edf7 : #8a98b5, fondo)
        celda(4, r, n > 0 ? "n=" + str.tostring(n) : "", #8a98b5, fondo)
    true

// Busca en los seguidores los conteos de un nivel por su nombre.
conteo(string nombre, bool aguantes) =>
    int r = 0
    if verStats and array.size(seguidores) > 0
        for i = 0 to array.size(seguidores) - 1
            Seguidor sg = array.get(seguidores, i)
            if sg.nombre == nombre
                r := aguantes ? sg.aguanto : sg.rompio
    r

if verTabla and barstate.islast
    fondoEnc = color.new(#0e1626, 0)
    celda(0, 0, "Nivel",  #8a98b5, fondoEnc)
    celda(1, 0, "Precio", #8a98b5, fondoEnc)
    celda(2, 0, "Dist.",  #8a98b5, fondoEnc)
    celda(3, 0, "Aguanta", #8a98b5, fondoEnc)
    celda(4, 0, "Toques", #8a98b5, fondoEnc)

fila(1, "Cierre RTH prev", prevC, colSesion,
     conteo("Cierre RTH prev", true), conteo("Cierre RTH prev", false))
fila(2, "Máx RTH previo",  prevH, colSesion,
     conteo("Máx RTH previo", true),  conteo("Máx RTH previo", false))
fila(3, "Mín RTH previo",  prevL, colSesion,
     conteo("Mín RTH previo", true),  conteo("Mín RTH previo", false))
fila(4, "Máx Globex",      glxH,  colSesion,
     conteo("Máx Globex", true),      conteo("Máx Globex", false))
fila(5, "Mín Globex",      glxL,  colSesion,
     conteo("Mín Globex", true),      conteo("Mín Globex", false))
fila(6, "VWAP",            vwapSesion, colVWAP, 0, 0)
fila(7, "Pivote PP",       pp, colSesion, conteo("Pivote PP", true), conteo("Pivote PP", false))
fila(8, "Muro calls",      muroCall  > 0 ? muroCall  : na, colOpciones, 0, 0)
fila(9, "Gamma cero",      gammaCero > 0 ? gammaCero : na, colOpciones, 0, 0)
fila(10, "Max pain",       maxPain   > 0 ? maxPain   : na, colOpciones, 0, 0)
fila(11, "Muro puts",      muroPut   > 0 ? muroPut   : na, colOpciones, 0, 0)

// LA FILA QUE IMPORTA. Si tus niveles no le ganan a esta, la tasa alta es del
// método de medición y no del nivel. Medido sobre ES y NQ, el control da ~73%.
if verTabla and verStats and barstate.islast and nControl > 0
    bc = baseControl()
    int nc = 0
    if array.size(seguidores) > 0
        for i = 0 to array.size(seguidores) - 1
            Seguidor sg = array.get(seguidores, i)
            if sg.control
                nc += sg.aguanto + sg.rompio
    fondoC = color.new(#1e2a45, 20)
    celda(0, 12, "CONTROL al azar", #e8b64c, fondoC)
    celda(1, 12, "—", #8a98b5, fondoC)
    celda(2, 12, "—", #8a98b5, fondoC)
    celda(3, 12, na(bc) ? "—" : str.tostring(math.round(bc)) + "%", #e8b64c, fondoC)
    celda(4, 12, nc > 0 ? "n=" + str.tostring(nc) : "", #8a98b5, fondoC)

// ───────────────────────────── Alertas ─────────────────────────────
// `alert()` permite mensaje dinámico; se dispara una vez por barra cerrada
// para no inundar la alerta con cada tick que oscila sobre el nivel.
cruza(float nivel) =>
    na(nivel) ? false :
         (close > nivel + margenAviso and close[1] <= nivel + margenAviso) or
         (close < nivel - margenAviso and close[1] >= nivel - margenAviso)

avisar(float nivel, string nombre) =>
    if avisarCruce and barstate.isconfirmed and cruza(nivel)
        alert(syminfo.ticker + " cruzó " + nombre + " en " +
             str.tostring(nivel, format.mintick), alert.freq_once_per_bar_close)
    true

avisar(prevH, "el máximo del RTH previo")
avisar(prevL, "el mínimo del RTH previo")
avisar(prevC, "el cierre del RTH previo")
avisar(glxH,  "el máximo de Globex")
avisar(glxL,  "el mínimo de Globex")
avisar(vwapSesion, "el VWAP de sesión")
avisar(muroCall  > 0 ? muroCall  : na, "el muro de calls")
avisar(muroPut   > 0 ? muroPut   : na, "el muro de puts")
avisar(gammaCero > 0 ? gammaCero : na, "el gamma cero")
avisar(maxPain   > 0 ? maxPain   : na, "el max pain")

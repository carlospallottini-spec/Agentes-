# Clave de API de Anthropic (https://console.anthropic.com) — necesaria para la narrativa.
# Sin esta clave, el oráculo igual calcula el score determinístico (--no-narrative).
ANTHROPIC_API_KEY=sk-ant-...

# La SEC exige un User-Agent con un contacto real para usar EDGAR.
SEC_USER_AGENT=Turpial Finanzas research bot (contacto: tu-email@ejemplo.com)

# Token para proteger el endpoint /cron/{cadencia} (cadena aleatoria que TÚ elegís).
# El cron externo debe mandarlo en el header X-Cron-Token.
CRON_TOKEN=cambiame-por-una-cadena-aleatoria

# --- Conectores premium (OPCIONALES) ---------------------------------------
# Estas plataformas NO tienen API pública. Si conseguís una credencial privada,
# pegala acá y extendé connectors/premium.py. Sin esto, esas fuentes devuelven no_data.
# TIKR_API_KEY=
# KOYFIN_API_KEY=

# Puerto del servidor (Railway/Render lo inyectan; por defecto 8000 en local).
PORT=8000
